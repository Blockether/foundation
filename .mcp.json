{
    "mcpServers": {
        "search-engine": {
            "type": "http",
            "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
            "headers": {
                "Authorization": "Bearer ${Z_AI_API_KEY}"
            }
        },
        "website-reader": {
            "type": "http",
            "url": "https://api.z.ai/api/mcp/web_reader/mcp",
            "headers": {
                "Authorization": "Bearer ${Z_AI_API_KEY}"
            }
        },
        "agno": {
            "type": "http",
            "url": "https://docs.agno.com/mcp"
        },
        "image-analysis": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@z_ai/mcp-server"
            ],
            "env": {
                "Z_AI_API_KEY": "${Z_AI_API_KEY}",
                "Z_AI_MODE": "ZAI"
            }
        }
    }
}